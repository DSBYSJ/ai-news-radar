{
  "name": "ai-news-web",
  "private": true,
  "version": "0.42.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --base=/news/",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism",
    "bump:patch": "npm version patch --no-git-tag-version",
    "see": "node scripts/see.mjs",
    "check:types": "tsc --noEmit && npm --prefix server exec tsc --noEmit",
    "check:test": "npm test && npm --prefix server test",
    "check:build": "npm run build:web",
    "check:audit": "node scripts/pre-push-audit.mjs --range origin/main..HEAD",
    "check": "npm run check:types && npm run check:test && npm run check:build && npm run check:audit",
    "check:security": "npm audit --omit=dev && npm --prefix server audit --omit=dev",
    "check:full": "npm run check && npm run check:security"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
