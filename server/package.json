{
  "name": "ai-news-server",
  "version": "0.27.0",
  "private": true,
  "description": "AI 资讯趋势雷达 · 后端（采集 / 存储 / 趋势统计）",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "collect": "node src/collector/run.ts",
    "process": "node src/ai/run.ts",
    "pipeline": "node src/jobs/run.ts",
    "summary": "node src/ai/summary-run.ts",
    "clusters": "node src/analytics/clusters-run.ts",
    "bursts": "node src/analytics/bursts-run.ts",
    "sentiment": "node src/ai/sentiment-run.ts",
    "ask": "node src/ai/ask-run.ts",
    "risk": "node src/risk/run.ts",
    "risk:backfill": "node src/risk/backfill-run.ts",
    "realign:entities": "node src/entities/run.ts",
    "mcp": "node src/mcp/stdio.ts",
    "prune": "node src/tools/prune.ts",
    "backfill:content": "node src/tools/backfill-content.ts",
    "clean:content": "node src/tools/clean-content.ts",
    "clean:relevance": "node src/tools/clean-relevance.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "bump:patch": "npm version patch --no-git-tag-version"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.4",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
