# 复制为 .env 后按需修改（.env 已被 .gitignore 排除，绝不提交）
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

DATABASE_PATH=./data/ai-news.db

# 采集用途的 User-Agent：合规要求「明确、可联系」（见 docs/合规检查清单.md 第二节）
FETCH_UA=ai-news-radar/0.1 (personal feed reader)

# ---- 以下上线时填写（本地开发不需要）----
# JWT_SECRET=            # 与骑行看板共用同一个值 → 两个服务共享登录态
# SESSION_DAYS=30
# COOKIE_SECURE=true
# TRUST_PROXY=1
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 美股行情与估值（FMP 免费档即可：250 次/天、512MB/月、日线近 5 年）
# 注意：免费档只覆盖部分标的，未覆盖的会返回 402
# FMP_API_KEY=
# SEC EDGAR 要求 User-Agent 带联系方式，否则会被限流
# SEC_USER_AGENT=ai-news-radar/0.38 (personal research; contact: you@example.com)
